{
  "name": "realif-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "REAL LIFE+ - Social Life Simulator Game",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "cd apps/mobile && npm start",
    "backend": "cd apps/backend && npm run start:dev",
    "mobile:ios": "cd apps/mobile && expo run:ios",
    "mobile:android": "cd apps/mobile && expo run:android",
    "mobile:build:ios": "cd apps/mobile && eas build --platform ios",
    "mobile:build:android": "cd apps/mobile && eas build --platform android",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
